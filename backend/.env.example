# Copy to .env to change settings. All values below are the defaults.

# DB_PATH=data/inbox.db
# TOP_K=5

# Easiest: set a Gemini key to get real LLM answers from Google Gemini.
# Get one at https://aistudio.google.com/apikey
# GEMINI_MODEL=gemini-flash-lite-latest

# Or use any OpenAI-compatible provider (OpenAI, Ollama, Groq...).
# LLM_API_KEY wins over GEMINI_API_KEY if both are set.
# Leave all keys empty to get answers that quote your saved text.
# LLM_API_KEY=
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini
